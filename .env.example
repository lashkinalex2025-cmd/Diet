# Optional base path for GitHub Pages (default: /Diet/)
# VITE_BASE_PATH=/Diet/

# Open Food Facts is used by default and does not require a key.
VITE_FOOD_API_URL=https://world.openfoodfacts.org
VITE_FOOD_API_KEY=

# Optional: set to "usda" to use USDA FoodData Central (requires API key)
# VITE_FOOD_PROVIDER=openfoodfacts
# VITE_USDA_API_KEY=
