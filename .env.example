# Optional base path for GitHub Pages (default: /Diet/)
# VITE_BASE_PATH=/Diet/

# Optional override for Open Food Facts search host (fallback only).
# Primary hosts are world/ru.openfoodfacts.org (CORS-friendly).
# VITE_FOOD_API_URL=https://search.openfoodfacts.org
VITE_FOOD_API_URL=
VITE_FOOD_API_KEY=

# Optional: set to "usda" to use USDA FoodData Central (requires API key)
# VITE_FOOD_PROVIDER=openfoodfacts
# VITE_USDA_API_KEY=
